#!/usr/bin/env bash
# find-anything [query]       fuzzy search file names   (alt-c: switch to contents)
# find-anything -c [query]    search inside files       (alt-n: switch to names)
# Enter opens the pick: text in $EDITOR (at the matching line), anything else with xdg-open.
# Photos/videos: use Immich smart search instead.

set -uo pipefail
cd "$HOME" || exit 1
self=$(realpath "$0")

# content folders (missing ones are skipped)
ROOTS=()
for d in notes code docs art media archive inbox; do
  [[ -d $d ]] && ROOTS+=("$d")
done

list_names() {
  if command -v fd >/dev/null; then
    fd --type f --hidden --exclude .git --color never . "${ROOTS[@]}"
  else
    find "${ROOTS[@]}" \( -name .git -o -name node_modules -o -name target -o -name .venv \
      -o -name venv -o -name __pycache__ -o -name dist -o -name build \) -prune -o -type f -print
  fi
}

is_text() { [[ $(file --mime-encoding -b -- "$1") != binary ]]; }

open_file() {
  local f=$1 line=${2:-}
  if is_text "$f"; then
    ${EDITOR:-nvim} ${line:+"+$line"} -- "$f"
  else
    setsid -f xdg-open "$f" >/dev/null 2>&1
  fi
}

case ${1:-} in
  --list) list_names; exit 0 ;;
  --grep)
    [[ -n ${2:-} ]] || exit 0
    rg --column --line-number --no-heading --color=always --smart-case --hidden -g '!.git' \
      -- "$2" "${ROOTS[@]}" 2>/dev/null
    exit 0 ;;
  --preview)
    f=$2; line=${3:-1}
    if is_text "$f"; then
      start=$(( line > 10 ? line - 10 : 1 ))
      sed -n "${start},$(( start + 80 ))p" -- "$f"
    else
      file -b -- "$f"; ls -lh -- "$f" | awk '{print $5, $6, $7, $8}'
    fi
    exit 0 ;;
  -c)
    shift
    sel=$(fzf --ansi --disabled --query "${*:-}" --with-shell 'bash -c' \
      --prompt 'contents> ' --delimiter : \
      --bind "start:reload:'$self' --grep {q}" \
      --bind "change:reload:sleep 0.1; '$self' --grep {q}" \
      --bind "alt-n:become('$self' {q})" \
      --preview "'$self' --preview {1} {2}" --preview-window 'right,55%,+{2}-10') || exit 0
    open_file "$(cut -d: -f1 <<<"$sel")" "$(cut -d: -f2 <<<"$sel")"
    ;;
  *)
    sel=$(list_names | fzf --query "${*:-}" --with-shell 'bash -c' --prompt 'names> ' --scheme path \
      --bind "alt-c:become('$self' -c {q})" \
      --preview "'$self' --preview {}" --preview-window 'right,55%') || exit 0
    open_file "$sel"
    ;;
esac
