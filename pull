#!/bin/env bash

set -euo pipefail

BOLD=$'\033[1m'; BLUE=$'\033[34m'; GREEN=$'\033[32m'; RESET=$'\033[0m'
step() { echo "${BOLD}${BLUE}==>${RESET} ${BOLD}$*${RESET}"; }
ok()   { echo "  ${GREEN}✓${RESET} $*"; }

cd "$(dirname "$0")"

step "fetching"
git fetch origin

step "resetting to origin/master"
git reset --hard origin/master

step "syncing yolk eggs"
yolk sync

ok "pulled"
